{
  "dashboard": {
    "id": null,
    "title": "Udaya Network Health",
    "tags": ["udaya", "network"],
    "timezone": "browser",
    "schemaVersion": 16,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "Connected Peers",
        "type": "stat",
        "targets": [
          {
            "expr": "udaya_p2p_peers_connected",
            "legendFormat": "Peers"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 3 },
                { "color": "green", "value": 8 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Block Height",
        "type": "stat",
        "targets": [
          {
            "expr": "udaya_blockchain_height",
            "legendFormat": "Height"
          }
        ]
      },
      {
        "id": 3,
        "title": "Network Hashrate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(udaya_mining_hashrate_total[5m])",
            "legendFormat": "Hashrate"
          }
        ]
      },
      {
        "id": 4,
        "title": "Mempool Size",
        "type": "graph",
        "targets": [
          {
            "expr": "udaya_mempool_size",
            "legendFormat": "Transactions"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
