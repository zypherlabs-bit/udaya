# Udaya Blockchain Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# RPC Configuration
RPC_USER=your_secure_username_here
RPC_PASSWORD=your_strong_random_password_here
RPC_ENABLE_WS=true
RPC_WS_PORT=8333

# Network Configuration
NETWORK=mainnet
LISTEN_PORT=9798
EXTERNAL_IP=
MAX_PEERS=125

# Mining Configuration
MINING_ENABLE=false
MINER_THREADS=1
COINBASE_ADDRESS=

# Wallet Configuration
WALLET_ENABLE=true
WALLET_FILE=wallet.dat

# Storage Configuration
DATA_DIR=/var/lib/Udaya/data
DB_CACHE_SIZE_MB=2048

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/Udaya/Udaya.log

# Exchange Integration (if applicable)
EXCHANGE_RPC_USER=
EXCHANGE_RPC_PASSWORD=

# Seed Node Configuration (for deployments)
SEED_NODE_NAME=
SEED_NODE_REGION=

# Database Passwords (if using external databases)
DB_PASSWORD=

# API Keys (if applicable)
API_KEY=
API_SECRET=